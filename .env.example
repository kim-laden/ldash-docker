# Copy to .env only if you want to change the defaults. Do not commit .env.
# This stack has no secrets. The API needs no keys or passwords.

# Where the web container is published on the host.
BIND_ADDR=127.0.0.1
HOST_PORT=18084

# Public address of this stack's demo API, used in the vault.conf links it returns.
# For a local Kali/Debian install keep the default below.
# Behind a proxy / on the VPS demo path, e.g. https://laden.no/docker/ldash/ldash
LDASH_PUBLIC_URL=http://127.0.0.1:18084/docker/ldash/ldash
